{
	"name": "@roo-code/agent-interchange",
	"description": "Read, brief and hand off coding-agent sessions between Claude Code and Tumble Code.",
	"version": "0.0.1",
	"type": "module",
	"exports": "./src/index.ts",
	"bin": {
		"agent-interchange-mcp": "./dist/mcp-server.mjs",
		"agent-interchange-install": "./dist/install.mjs"
	},
	"scripts": {
		"build": "node esbuild.mjs",
		"install:mcp": "pnpm build && node dist/install.mjs install",
		"uninstall:mcp": "node dist/install.mjs uninstall",
		"lint": "eslint src --ext=ts --max-warnings=0",
		"check-types": "tsc --noEmit",
		"test": "vitest run",
		"clean": "rimraf dist .turbo"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.26.0",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@roo-code/config-eslint": "workspace:^",
		"@roo-code/config-typescript": "workspace:^",
		"@types/node": "20.x",
		"esbuild": "^0.25.0",
		"rimraf": "^6.0.1",
		"vitest": "^3.2.3"
	}
}
